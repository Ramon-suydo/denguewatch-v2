# Browser-safe public project configuration (copy to .env.local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Force the verified public-data snapshot; all real submissions remain disabled.
VITE_DEMO_MODE=false

# Server-only direct/session PostgreSQL connection for manual ingestion.
# Use the Supabase Connect panel. Never prefix this with VITE_.
DIRECT_DATABASE_URL=
# Optional trusted CA PEM file; TLS verification is never disabled.
DB_SSL_CA_FILE=

# Server-only launch operations; values stay in ignored local/hosting configuration.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ROTATED=0
REPORTING_ENABLED=true
LAUNCH_GATES_PASSED=0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Private guard metadata; never publish the old credential or its fingerprint.
EXPOSED_CREDENTIAL_SHA256=
