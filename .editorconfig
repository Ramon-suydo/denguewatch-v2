root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Preserve exact published source bytes and checksums.
[data/raw/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
