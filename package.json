{
  "name": "denguewatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/data-and-security.test.ts tests/database-tls.test.ts tests/forecast.test.ts tests/composite.test.ts tests/weekly-forecast.test.ts tests/source-metadata.test.ts tests/demo-snapshot.test.ts tests/fixture-build-guard.test.ts tests/data-confidence.test.ts tests/tondo-map.test.ts tests/manila-data.test.ts tests/manila-model.test.ts tests/research-security.test.ts tests/reporting-v2.test.ts tests/launch-gate.test.ts tests/local-setup.test.ts tests/ncr-colors.test.ts tests/measurements.test.ts tests/environment.test.ts tests/retention-launch.test.ts tests/secret-audit.test.mjs tests/reporting-scope.test.ts tests/redesign-data.test.ts tests/ml-scorer.test.ts tests/ncr-upload.test.ts tests/ml-colors.test.ts tests/ui-examples.test.ts tests/live-manila.test.ts",
    "data:audit": "tsx scripts/ingest-historical.ts --dry-run",
    "ingest": "tsx scripts/ingest-historical.ts",
    "db:verify": "node scripts/db-verify.mjs",
    "test:ui": "playwright test",
    "test:contrast": "node scripts/check-contrast.mjs",
    "forecast:refresh": "tsx scripts/manage-public-app.ts --refresh",
    "app:setup": "tsx scripts/manage-public-app.ts --apply",
    "reports:enable": "tsx scripts/manage-public-app.ts --enable-reports",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "forecast:backtest": "tsx scripts/backtest-weekly.ts",
    "risk:backtest": "tsx scripts/backtest-risk.ts",
    "geo:build": "tsx scripts/build-geo.ts",
    "data:prepare": "tsx scripts/prepare-manila.ts && tsx scripts/audit-measurements.ts",
    "security:secrets": "node scripts/audit-secrets.mjs",
    "weather:fetch": "tsx scripts/fetch_weather.ts",
    "evaluate": "tsx scripts/evaluate-manila.ts && tsx scripts/evaluation-extras.ts && tsx scripts/publish-evidence.ts && tsx scripts/prepare-environment.ts && tsx scripts/evaluate-environment.ts && python scripts/plot-evaluation.py && python scripts/plot-environment.py && python scripts/geographic-context.py && python scripts/document-environment.py",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts --max-warnings 0",
    "data:publish": "tsx scripts/publish-evidence.ts",
    "postbuild": "node scripts/prerender-shell.mjs && node scripts/build-pwa.mjs",
    "evaluate:plots": "python scripts/plot-evaluation.py",
    "demo": "npm run build && vite preview --host 127.0.0.1",
    "test:pwa": "playwright test --config playwright.production.config.ts",
    "security:zap": "node scripts/scan-zap.mjs",
    "audit:lighthouse": "npm exec --yes --package=node@22 --package=lighthouse@13 -- node scripts/audit-lighthouse.mjs",
    "setup:local": "tsx scripts/setup-local.ts",
    "staff:dev": "vite --mode staff --host 127.0.0.1",
    "demo:record": "node scripts/record-demo.mjs",
    "environment:fetch": "npm run weather:fetch && tsx scripts/fetch_power.ts && tsx scripts/fetch_geography.ts && python scripts/geographic-context.py --grid && tsx scripts/fetch_elevation.ts",
    "environment:prepare": "tsx scripts/prepare-environment.ts && tsx scripts/evaluate-environment.ts && python scripts/geographic-context.py && python scripts/plot-environment.py && python scripts/document-environment.py",
    "weather:refresh": "tsx scripts/refresh-weather-context.ts",
    "test:geography": "python tests/geography-context.test.py",
    "db:verify:legacy": "tsx scripts/ingest-historical.ts --verify-only",
    "credentials:verify": "node scripts/verify-credentials.mjs",
    "hosted:bootstrap": "node scripts/bootstrap-hosted.mjs",
    "hosted:admin": "node scripts/create-first-admin.mjs",
    "reports:off": "node scripts/bootstrap-hosted.mjs --reporting-off",
    "test:production": "playwright test --config playwright.research.config.ts",
    "data:validate": "node scripts/validate-shipped-data.mjs",
    "prebuild": "npm run count:check && npm run live:check && npm run data:validate && npm run credits:check && npm run test:hero-contrast",
    "data:inventory": "node scripts/inventory-markers.mjs",
    "evaluate:map": "python scripts/evaluate-map.py",
    "map:prepare": "python scripts/prepare-map.py",
    "map:weather": "python scripts/fetch-map-weather.py",
    "credits:generate": "node scripts/generate-credits.mjs",
    "credits:check": "node scripts/check-credits.mjs",
    "test:hero-contrast": "node scripts/check-hero-contrast.mjs",
    "ml:train": "node scripts/ml-run.mjs train",
    "ml:evaluate": "node scripts/ml-run.mjs evaluate",
    "ml:export": "node scripts/ml-run.mjs export",
    "ml:test": "node scripts/ml-run.mjs test",
    "test:ui-budget": "node scripts/check-ui-budget.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "live:ingest": "tsx scripts/ingest_live_manila.ts",
    "live:check": "tsx scripts/check-live-manila-data.ts",
    "count:evaluate": "node scripts/expanded-count.mjs evaluate",
    "count:test": "node scripts/expanded-count.mjs test",
    "count:check": "node scripts/check-expanded-count.mjs",
    "count:weather": "tsx scripts/fetch-expanded-weather.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "@supabase/supabase-js": "^2.109.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3"
  }
}
