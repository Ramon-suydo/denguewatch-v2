{
  "name": "denguewatch-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/data-and-security.test.ts tests/database-tls.test.ts tests/forecast.test.ts tests/composite.test.ts tests/weekly-forecast.test.ts tests/source-metadata.test.ts tests/demo-snapshot.test.ts tests/fixture-build-guard.test.ts tests/data-confidence.test.ts tests/tondo-map.test.ts",
    "data:audit": "tsx scripts/ingest-historical.ts --dry-run",
    "ingest": "tsx scripts/ingest-historical.ts",
    "db:verify": "tsx scripts/ingest-historical.ts --verify-only",
    "test:ui": "playwright test",
    "test:contrast": "node scripts/check-contrast.mjs",
    "forecast:refresh": "tsx scripts/manage-public-app.ts --refresh",
    "app:setup": "tsx scripts/manage-public-app.ts --apply",
    "reports:enable": "tsx scripts/manage-public-app.ts --enable-reports",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "forecast:backtest": "tsx scripts/backtest-weekly.ts",
    "risk:backtest": "tsx scripts/backtest-risk.ts",
    "geo:build": "tsx scripts/build-geo.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
