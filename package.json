    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
